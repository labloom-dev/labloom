{
    "name": "labloom",
    "version": "1.0.0",
    "type": "module",
    "description": "An all-in-one AI research workspace for the entire research lifecycle.",
    "main": "./dist/main/index.js",
    "license": "MIT",
    "author": "labloom.dev",
    "homepage": "https://labloom.dev",
    "scripts": {
        "lint": "eslint --config configs/eslint.config.js --cache --cache-location dist/.eslintcache .",
        "lint:fix": "eslint --config configs/eslint.config.js --fix .",
        "lint:test": "node configs/config.test.js",
        "typecheck:node": "tsc --noEmit -p configs/tsconfig.node.json",
        "svelte-check": "svelte-check --tsconfig ./tsconfig.json --config ./configs/svelte.config.js",
        "typecheck": "npm run typecheck:node && npm run svelte-check",
        "start": "electron-vite preview --config configs/electron.vite.config.ts",
        "dev": "electron-vite dev --config configs/electron.vite.config.ts",
        "build": "npm run typecheck && electron-vite build --config configs/electron.vite.config.ts",
        "build:unpack": "npm run build && electron-builder --dir",
        "build:win": "npm run build && electron-builder --win",
        "build:mac": "npm run build && electron-builder --mac",
        "build:linux": "npm run build && electron-builder --linux"
    },
    "build": {
        "extends": "./configs/electron-builder.yml"
    },
    "dependencies": {
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/utils": "^4.0.0",
        "@tiptap/core": "^3.31.3",
        "@tiptap/extension-document": "^3.31.3",
        "@tiptap/extension-dropcursor": "^3.31.3",
        "@tiptap/extension-history": "^3.31.3",
        "@tiptap/extension-paragraph": "^3.31.3",
        "@tiptap/extension-placeholder": "^3.31.3",
        "@tiptap/extension-text": "^3.31.3",
        "@tiptap/pm": "^3.31.3",
        "@tiptap/starter-kit": "^3.31.3",
        "better-sqlite3": "^13.0.3",
        "bits-ui": "^2.19.2",
        "pdfjs-dist": "6.3.289",
        "uuid": "^14.0.2"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config-ts": "^3.1.0",
        "@electron-toolkit/tsconfig": "^2.0.0",
        "@eslint/css": "^2.0.0",
        "@eslint/json": "^2.1.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^22.20.2",
        "electron": "^39.8.10",
        "electron-builder": "^26.15.3",
        "electron-vite": "^5.0.0",
        "eslint": "^10.10.0",
        "eslint-plugin-svelte": "^3.23.0",
        "eslint-plugin-yml": "^3.8.1",
        "svelte": "^5.57.0",
        "svelte-check": "^4.7.6",
        "typescript": "^5.9.3",
        "vite": "^7.3.6",
        "vite-plugin-static-copy": "4.1.1"
    }
}