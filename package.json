{
    "name": "labloom",
    "version": "0.1.0",
    "type": "module",
    "description": "An all-in-one AI research workspace for the entire research lifecycle.",
    "main": "./dist/main/index.js",
    "license": "MIT",
    "author": "Labloom Contributors",
    "homepage": "https://labloom.dev",
    "packageManager": "pnpm@12.5.1",
    "scripts": {
        "lint": "eslint --config configs/eslint.config.js --cache --cache-location dist/.eslintcache .",
        "knip": "knip --config configs/knip.jsonc",
        "lint:fix": "eslint --config configs/eslint.config.js --fix .",
        "test": "npm run test:feed && npm run test:db",
        "test:feed": "node --test configs/feed.test.js",
        "test:db": "node --import tsx --test tests/database-tools.test.ts && node tests/run-workspace.mjs",
        "perf": "node tests/run-workspace.mjs --perf",
        "db:generate": "node --import tsx scripts/database.mjs generate",
        "db:check": "node --import tsx scripts/database.mjs check",
        "db:init": "node --import tsx scripts/database.mjs init",
        "db:status": "node --import tsx scripts/database.mjs status",
        "db:diagram": "drizzle-lab visualizer --config ./configs/drizzle.config.ts --save-dir ./.local/schema-diagram --project-id labloom --port 64739",
        "typecheck:node": "tsc --noEmit -p configs/tsconfig.node.json",
        "svelte-check": "svelte-check --tsconfig ./configs/tsconfig.web.json --config ./configs/svelte.config.js",
        "typecheck": "npm run typecheck:node && npm run svelte-check",
        "start": "electron-vite preview --config configs/electron.vite.config.ts",
        "dev": "electron-vite dev --config configs/electron.vite.config.ts",
        "dev:feed": "vite --config configs/feed.preview.ts",
        "build": "npm run typecheck && electron-vite build --config configs/electron.vite.config.ts",
        "build:unpack": "npm run build && electron-builder --dir",
        "build:win": "npm run build && electron-builder --win",
        "build:mac": "npm run build && electron-builder --mac",
        "build:linux": "npm run build && electron-builder --linux"
    },
    "build": {
        "extends": "./configs/electron-builder.yml"
    },
    "dependencies": {
        "@tiptap/core": "^3.31.3",
        "@tiptap/extension-document": "^3.31.3",
        "@tiptap/extension-history": "^3.31.3",
        "@tiptap/extension-table": "3.31.3",
        "@tiptap/extension-text": "^3.31.3",
        "@tiptap/pm": "^3.31.3",
        "better-sqlite3": "^13.0.3",
        "bits-ui": "^2.19.2",
        "drizzle-orm": "^0.45.4",
        "i18next": "26.4.2",
        "pdfjs-dist": "6.3.289",
        "rss-parser": "^3.13.0",
        "typia": "~12.2.1",
        "uuid": "^14.0.2"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config-ts": "^3.1.0",
        "@electron-toolkit/tsconfig": "^2.0.0",
        "@eslint/css": "^2.0.0",
        "@eslint/json": "^2.1.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@napi-rs/canvas": "1.0.9",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^22.20.2",
        "@typia/unplugin": "~12.2.1",
        "drizzle-kit": "0.31.11",
        "drizzle-lab": "0.11.0",
        "electron": "^45.0.0",
        "electron-builder": "^26.15.3",
        "electron-vite": "^6.0.0",
        "esbuild": "0.25.12",
        "eslint": "^10.10.0",
        "eslint-plugin-svelte": "^3.23.0",
        "eslint-plugin-yml": "^3.8.1",
        "knip": "^6.45.1",
        "svelte": "^5.57.0",
        "svelte-check": "^4.7.6",
        "tsx": "^4.23.15",
        "typescript": "6.0.3",
        "vite": "^8.3.5",
        "vite-plugin-static-copy": "4.1.1"
    }
}