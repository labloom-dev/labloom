{
    "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
    "include": ["electron.vite.config.*", "ipc-validators.ts", "drizzle.config.ts", "feed.preview.ts", "../main/**/*", "../preload/**/*", "../shared/**/*", "../locales/*.json"],
    "compilerOptions": {
        "rootDir": "..",
        "emitDeclarationOnly": true,
        "outDir": "../dist/types/node",
        "composite": true,
        "tsBuildInfoFile": "../dist/tsconfig.node.tsbuildinfo",
        "strict": true,
        "checkJs": true,
        "types": ["node", "electron-vite/node"]
    }
}