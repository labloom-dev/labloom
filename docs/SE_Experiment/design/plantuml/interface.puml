@startsalt
skinparam backgroundColor white
!function $cn($text)
!return "<font:Noto Sans CJK SC>" + $text + "</font>"
!endfunction
{
  {+ $cn("知织 · 当前工作区") | "$cn('搜索资料…')             " | ^$cn("范围：全部")^ }
  {
    {+ $cn("导航")
      [ $cn("订阅") ]
      [ $cn("文献") ]
      [ $cn("笔记") ]
      .
      .
      .
      .
    } |
    {+ $cn("笔记列表") | [ $cn("＋ 新建") ]
      ==
      $cn("课题阅读记录") | $cn("11 月 10 日")
      --
      $cn("相关论文整理") | $cn("11 月 10 日")
      --
      $cn("实验计划") | $cn("11 月 10 日")
      . | .
      . | .
      [ $cn("上一页") ] | [ $cn("下一页") ]
    } |
    {+ $cn("课题阅读记录")
      --
      { [ $cn("正文格式") ] | [ $cn("插入文献链接") ] }
      --
      $cn("本周阅读内容")
      $cn("整理研究问题、方法与结论。")
      .
      $cn("参考文献：相关论文")
      .
      .
    }
  }
  {+ $cn("索引已就绪") | $cn("已保存") }
}
@endsalt
